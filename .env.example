# Copy this file to .env and fill in your values

# HuggingFace Pro API Token (required)
HF_TOKEN=hf_your_token_here

# OpenAI API Token (required if USE_OPENAI_MODELS=true)
USE_OPENAI_MODELS=true
OPENAI_API_KEY=openai_api_key

# LangSmith Observability (optional)
# LANGSMITH_API_KEY=lsv2_your_key_here
# LANGCHAIN_PROJECT=ghost-twin

# Operational Mode
# Set to "true" for conference demo mode (rich output, in-memory DB, HITL prompt)
GHOST_DEMO_MODE=false
# Print MTTD (Mean Time To Diagnose) panel after each agent run
GHOST_MTTD_MODE=true

# Service Identity
GHOST_SERVICE=demo-svc

# File Watching
# Path to file OR directory to watch
GHOST_WATCH_PATH=demo/app_test.py
GHOST_WATCH_RECURSIVE=false

# Models (optional overrides)
# HF_TRIAGE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# HF_DIAGNOSIS_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# HF_JUDGE_MODEL=meta-llama/Llama-3.3-70B-Instruct
# HF_EMBEDDING_MODEL=Salesforce/codet5p-110m-embedding

# OPENAI_TRIAGE_MODEL=gpt-4o-mini
# OPENAI_DIAGNOSIS_MODEL=gpt-4o
# OPENAI_JUDGE_MODEL=gpt-4o-mini

# Infrastructure (not needed in DEMO_MODE)
QDRANT_HOST=localhost
QDRANT_PORT=6333
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
NATS_URL=nats://localhost:4222

# Agent Tuning
AGENT_MAX_HYPOTHESES=2
AGENT_CONTEXT_TOP_K=5
CONFIDENCE_THRESHOLD_AUTO=0.85
CONFIDENCE_THRESHOLD_WARN=0.65
# Cosine similarity threshold for duplicate error suppression (0.0-1.0)
GHOST_DEDUP_THRESHOLD=0.92
